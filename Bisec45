% 1(c) x = x^2 - exp(-x)
clc; clear;
f = @(x) x^2 - exp(-x) - x;
a = 1; b = 2;
tol = 1e-3;
fa = f(a);

fprintf('Iter\t a\t\t b\t\t c\t\t f(c)\n');
iter = 0;
while (b - a)/2 > tol
    c = (a + b)/2;
    fc = f(c);
    fprintf('%d\t %.4f\t %.4f\t %.4f\t %.6f\n', iter, a, b, c, fc);

    if fa*fc <= 0
        b = c;
    else
        a = c;
        fa = fc;
    end
    iter = iter + 1;
end
root = (a + b)/2;
fprintf('\nFinal Root = %.6f\n', root);
