clc; clear;
f = @(x) exp(x) + 2^(-x) + cos(x) - 6;
df = @(x) exp(x) - log(2)*2^(-x) - sin(x);
x0 = 1;
tol = 1e-6;
maxIter = 100;

fprintf('Iter\t xn\t\t f(xn)\t\t f''(xn)\t\t xn+1\t\t error\n');
x = x0;
for i = 1:maxIter
    fx = f(x); dfx = df(x);
    x_new = x - fx/dfx;
    err = abs(x_new - x);
    fprintf('%d\t %.10f\t %.4e\t %.4e\t %.10f\t %.4e\n', i, x, fx, dfx, x_new, err);
    if err < tol
        break;
    end
    x = x_new;
end
fprintf('\nRoot = %.13f\n', x_new);
